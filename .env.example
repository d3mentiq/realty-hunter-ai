# General Search Parameters (Example: Moscow / Saint Petersburg / Regional Hubs)
CITY=Москва
TARGET_DISTRICTS=Центральный,Северный,Западный,Приморский,Василеостровский,Советский
MIN_PRICE=25000
MAX_PRICE=50000
MAX_COMMISSION=25000
MAX_MOVE_IN_COST=80000

# Filters (Mixed generic keywords and multi-city industrial/suburb tags)
DISALLOWED_FLOORS=1
DISALLOWED_KEYWORDS=цоколь,подвал,без окон,доля,комната,промзона,бабушкин,аварийный,капотня,бирюлево,девяткино,мурино,куйбышевский,волгарь,кряж,уралмаш,соцгород,116 км,сухая самарка,южный город

# Platform Slugs and Region IDs (Examples: Moscow = 1 / moskva; SPb = 2 / spb)
CIAN_REGION_ID=1
AVITO_CITY_SLUG=moskva
YANDEX_CITY_SLUG=moskva

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ALLOWED_USER_IDS=123456789,987654321

# AI Vision Evaluation (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Storage & Engine
DB_PATH=data/flats.db
SCAN_INTERVAL_SEC=300
